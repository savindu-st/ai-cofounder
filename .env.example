# AI Co-Founder - Environment Configuration Example
PROJECT_NAME="AI Co-Founder"
ENVIRONMENT="development"
LOG_LEVEL="INFO"

# LLM Providers
OPENAI_API_KEY="your-openai-api-key"
ANTHROPIC_API_KEY="your-anthropic-api-key"
GOOGLE_API_KEY="your-google-api-key"
DEFAULT_MODEL="gpt-4o"

# Search & Research APIs
TAVILY_API_KEY="your-tavily-api-key"
SERPER_API_KEY="your-serper-api-key"
MOCK_SEARCH="false"

# Database & Cache
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/aicofounder"
REDIS_URL="redis://localhost:6379/0"

# Service Ports & URLs (For microservice communication)
ORCHESTRATOR_URL="http://localhost:8000"
BI_SERVICE_URL="http://localhost:8001"
RESEARCH_SERVICE_URL="http://localhost:8002"
FINANCE_SERVICE_URL="http://localhost:8003"
MARKETING_SERVICE_URL="http://localhost:8004"
FRONTEND_URL="http://localhost:3000"
