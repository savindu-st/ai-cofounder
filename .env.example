# AI Co-Founder - Environment Configuration Example
PROJECT_NAME="AI Co-Founder"
ENVIRONMENT="development"
LOG_LEVEL="INFO"

# LLM Providers (Configure at least one)
OPENAI_API_KEY="your-openai-api-key"
ANTHROPIC_API_KEY="your-anthropic-api-key"
GOOGLE_API_KEY="your-google-api-key"
DEFAULT_MODEL="gpt-4o"

# Search & Research APIs
TAVILY_API_KEY="your-tavily-api-key"
SERPER_API_KEY="your-serper-api-key"
MOCK_SEARCH="false"

# Database & Cache (PostgreSQL + Redis)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/aicofounder"
REDIS_URL="redis://localhost:6379/0"

# Vector Store (ChromaDB)
CHROMA_PERSIST_DIRECTORY="./data/chroma"

# Security & Authentication
JWT_SECRET="dev-jwt-secret-key-change-in-production-123456"
JWT_ALGORITHM="HS256"
JWT_ACCESS_TOKEN_EXPIRE_MINUTES="1440"

# Application URLs (Monolith + Frontend)
ORCHESTRATOR_URL="http://localhost:8000"
FRONTEND_URL="http://localhost:3000"
